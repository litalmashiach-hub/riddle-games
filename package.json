{
  "name": "riddle-games",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @riddle/web dev",
    "build": "pnpm --filter @riddle/web build",
    "build:app": "pnpm --filter @riddle/web build:app",
    "ios:sync": "pnpm build:app && pnpm --filter @riddle/mobile exec cap sync ios",
    "preview": "pnpm --filter @riddle/web preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:e2e": "pnpm build && pnpm build:app && playwright test --config e2e/playwright.config.ts",
    "test:e2e:built": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
